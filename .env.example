# Copia este fichero como .env y rellena los valores. El .env NUNCA se sube a git.

# --- Base de datos (Neon: Dashboard > Connect) ---
# En local, las de la rama "desarrollo" de Neon (no las de produccion). Las de produccion van en .env.produccion
# (solo DATABASE_URL y DIRECT_URL), que usa "npm run migrar:produccion".
# Conexion con pooler (la usa la app)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx-pooler.REGION.aws.neon.tech/tienda?sslmode=verify-full"
# Conexion directa, sin "-pooler" (la usan las migraciones de Prisma)
DIRECT_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx.REGION.aws.neon.tech/tienda?sslmode=verify-full"

# --- Stripe en MODO TEST (Dashboard > Developers > API keys) ---
# Secreta: solo servidor. Empieza por sk_test_
STRIPE_SECRET_KEY=""
# Publicable: puede ir al navegador (por eso lleva NEXT_PUBLIC_). Empieza por pk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Secreto del webhook (Sesion 3, lo da "stripe listen"). Empieza por whsec_
STRIPE_WEBHOOK_SECRET=""

# --- Resend (Sesion 3): resend.com > API Keys. Empieza por re_ ---
RESEND_API_KEY=""
# Sin dominio propio verificado, Resend solo envia al email de tu cuenta: ponlo aqui en desarrollo
EMAIL_PRUEBAS=""

# --- Cuentas ---
# No hay variables: las contrasenas viven (cifradas) en la BD. El admin se crea con: npm run crear-admin -- <email>
